# Database Connection (Neon, Supabase, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# JWT Secret for Admin Authentication (generate a secure random key)
JWT_SECRET="Pro-Example_super_secret_jwt_key_change_in_production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Admin Credentials (used during database seeding)
ADMIN_EMAIL="admin@pro-example.com"
ADMIN_PASSWORD="your_secure_admin_password"
